# ==============================================================================
# SRM Chatbots Backend (Django REST API) - Environment Template
# Duplicate this file to '.env' and populate with your own values and credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Database URL connection string.
# Examples:
# - PostgreSQL: postgresql://username:password@hostname:5432/database_name?sslmode=require
# - Neon DB:    postgresql://neondb_owner:password@ep-xyz-pooler.us-east-2.aws.neon.tech/srm_chatbots_app?sslmode=require
# - SQLite:     sqlite:///db.sqlite3
DATABASE_URL=postgresql://user:password@localhost:5432/srm_chatbots_db

# ------------------------------------------------------------------------------
# 2. DJANGO CORE & SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Django secret key for cryptographic signing. Generate one using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key

# Set to True for development, False for production
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames/IPs
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 3. CORS & FRONTEND ACCESS
# ------------------------------------------------------------------------------
# Comma-separated origins allowed to make direct cross-origin requests
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 4. GEMINI AI CONFIGURATION (backend only)
# ------------------------------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey (a project ID is not a key).
# Keep the project on the free tier; requests are subject to Google's quotas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ------------------------------------------------------------------------------
# 5. OPTIONAL API TOKENS & CREDENTIALS
# ------------------------------------------------------------------------------
# Optional API token for test or administrative automation scripts
SRM_API_TOKEN=your-optional-api-token
